# ZCG Call Intelligence — local/dev template
# Copy to .env and set secrets. Never commit .env.

NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# --- DATABASE ---
DATABASE_URL=postgresql://zcg:zcg@localhost:5432/zcg_ci?schema=public

# --- REDIS ---
REDIS_URL=redis://localhost:6379

# --- AUTH ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
COOKIE_NAME=zcg_session
SEED_ADMIN_EMAIL=admin@zcg.local
SEED_ADMIN_PASSWORD=change-me-admin-password

# --- TELEPHONY ---
TELEPHONY_PROVIDER=fake
TELEPHONY_PRIMARY=fake
TELEPHONY_SECONDARY=
# Estimated connected-call telecom cost in dollars (DECIMAL)
DEFAULT_TELECOM_COST=0.0400

# --- STORAGE ---
STORAGE_PROVIDER=fake
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- EMAIL ---
EMAIL_PROVIDER=console

# --- AI / STT (unused in MVP) ---
AI_PROVIDER=none
STT_PROVIDER=none

# --- PAYMENTS ---
PAYMENTS_PROVIDER=none

# --- MONITORING ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=zcg-ci

# --- APP ---
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
FEATURE_RTB=true
FEATURE_DEMO=true
